# /etc/exe-soc/env  (chmod 600, owner root:exesoc). SANITISED EXAMPLE - every <...> must be replaced with a real value generated locally; never commit the real file.
SOC_ENV=production
SOC_SECRET=<64 hex chars: python tools/rotate_secrets.py session-secret --out /root/new-secret.env>
SOC_ENC_KEYS=<k1:base64url-32-bytes - generate: python tools/rotate_secrets.py enc-key --out ring.env ; keep an OFF-HOST copy>
SOC_DB=/var/lib/exe-soc/soc.db
SOC_TRUSTED_PROXIES=127.0.0.1
SOC_ALLOWED_ORIGINS=https://<soc.example.com>
SOC_AGENT_AUTH=hmac-required            # production default; use "permissive" ONLY while migrating unsigned agents
SOC_LEGACY_API_KEY=off                  # production default; "on" only while legacy hosts still use /api/ingest or /api/agent/*
SOC_MFA_REQUIRED=admin,analyst
SOC_SESSION_IDLE_MIN=30
SOC_SESSION_ABS_HOURS=12
SOC_BACKUP_DIR=/var/backups/exe-soc
SOC_AUDIT_CHECKPOINT_DIR=<WORM or remote mount for audit checkpoints>
# GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN (or *_FILE variants) only if EMAIL_METHOD=gmail_api; they come from tools/gmail_auth.py --write
# Never set in production: SOC_ALLOW_DEFAULT_CREDS, SOC_COOKIE_SECURE=0, SOC_ALLOW_LOOSE_DB_DIR
