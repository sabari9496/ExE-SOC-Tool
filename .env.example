# EXE-SOC email notifications: copy to a private file and set the real values in the SERVER environment. Never commit the real file.
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=soc@example.com
EMAIL_FROM=soc@example.com
# Choose ONE way to provide the password (never put it in the database or in Git):
SMTP_PASSWORD=<set-this-in-the-server-environment>
#SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# --- Option B: Gmail API instead of SMTP (OAuth over HTTPS). Run:  python tools/gmail_auth.py --credentials client_secret.json --write
#EMAIL_METHOD=gmail_api
#GMAIL_CLIENT_ID=<from Google Cloud OAuth client>
#GMAIL_CLIENT_SECRET=<from Google Cloud OAuth client>
#GMAIL_REFRESH_TOKEN=<printed by tools/gmail_auth.py>
# (or GMAIL_CLIENT_SECRET_FILE / GMAIL_REFRESH_TOKEN_FILE for Docker/Kubernetes secrets). With gmail_api, SMTP_HOST/PORT/SECURITY/USERNAME/PASSWORD are not used;
# EMAIL_FROM must be the authorised Gmail address (or one of its aliases) and SMTP_ENABLED=true still switches notifications on.
SOC_BASE_URL=https://soc.example.com
SOC_TLS_CERT=certs/server.pem   # native HTTPS for remote agents (see FLEET-GUIDE.md)
SOC_TLS_KEY=certs/server.key

# ---- Security (see docs/DEPLOYMENT.md). Sanitised example: generate real values, never commit ----
SOC_ENV=production                       # refuses the Werkzeug dev server; requires SOC_ENC_KEYS and SOC_BACKUP_DIR
SOC_SECRET=<python -c "import secrets;print(secrets.token_hex(32))">
SOC_ENC_KEYS=k1:<python -c "from security import crypto;print(crypto.new_key())">   # first = primary; keep old ids after rotation; store a copy OFF the server
SOC_BACKUP_DIR=/var/backups/exe-soc
SOC_AUDIT_CHECKPOINT_DIR=/mnt/offhost-worm/exe-soc-audit   # must be a mount/volume the SOC host cannot rewrite
SOC_COOKIE_SECURE=1
SOC_TRUSTED_PROXIES=127.0.0.1
SOC_ALLOWED_ORIGINS=https://soc.example.com
SOC_MFA_REQUIRED=admin,analyst           # default in production
SOC_AGENT_AUTH=hmac-required            # production default. Use "permissive" ONLY temporarily while migrating existing unsigned agents, then remove it
SOC_LEGACY_API_KEY=off                  # production default. "on" only temporarily while legacy hosts still use /api/ingest or /api/agent/*
SOC_SESSION_IDLE_MIN=30
SOC_SESSION_ABS_HOURS=12
SOC_MIN_PASSWORD=12
SOC_SYSLOG_PORT=0                        # off. If enabled: SOC_SYSLOG_BIND=<private IP> + firewall (unauthenticated protocol)
SOC_GEO_ENABLED=0                        # 1 = allow sending source IPs to the geo provider (also needs Settings geo_lookup=1)
# NEVER in production: SOC_ALLOW_DEFAULT_CREDS
